@page "/runs/{Id:guid}"
@inherits LiveComponentBase
@inject DashboardService Dashboard
@inject ArtifactService Artifacts
@inject RestoreService Restores
@inject JobService JobService
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTemplate Title="@(_run?.JobName ?? "Ejecución")" Subtitle="@(_run is null ? null : $"Iniciada {Display.DateTime(_run.StartedAt)}")"
              BackHref="/runs" BackLabel="Historial">
    <Actions>
        @if (_run is not null && CurrentUser.CanManage)
        {
            @if (_run.Status == RunStatus.Running)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="stop" OnClick="Cancel">Cancelar</Button>
            }
            else
            {
                <Button Variant="ButtonVariant.Secondary" Icon="refresh" OnClick="RunAgain">Ejecutar de nuevo</Button>
                <Button Variant="ButtonVariant.Ghost" Icon="trash" OnClick="() => _confirmDelete = true">Eliminar</Button>
            }
            <Button Variant="ButtonVariant.Ghost" Icon="edit" Href="@($"/jobs/{_run.JobId}")">Editar trabajo</Button>
        }
    </Actions>
    <ChildContent>
        @if (_run is null)
        {
            @if (_notFound)
            {
                <EmptyState Icon="alert" Title="Ejecución no encontrada" />
            }
            else
            {
                <div class="skeleton skeleton--card"></div>
            }
        }
        else
        {
            @if (_run.Status == RunStatus.Running)
            {
                <div class="progress" aria-label="En curso"><span></span></div>
            }

            <div class="stats">
                <Card Index="0" Class="kv">
                    <p class="kv__label">Estado</p>
                    <RunStatusBadge Status="_run.Status" />
                </Card>
                <Card Index="1" Class="kv">
                    <p class="kv__label">Duración</p>
                    <p class="kv__value">@(_run.Status == RunStatus.Running ? Display.Relative(_run.StartedAt).Replace("hace ", "") : Display.Duration(_run.Duration))</p>
                </Card>
                <Card Index="2" Class="kv">
                    <p class="kv__label">Tamaño</p>
                    <p class="kv__value">@ByteSize.Format(_run.SizeBytes)</p>
                </Card>
                <Card Index="3" Class="kv">
                    <p class="kv__label">Retención</p>
                    <p class="kv__value">@(_run.DeletedByRetention) eliminados</p>
                </Card>
            </div>

            @if (_run.Error is not null)
            {
                <div class="callout callout--@(_run.Status == RunStatus.Warning ? "warning" : "danger") animate-in"><Icon Name="alert" Size="16" /> <span>@_run.Error</span></div>
            }

            <Card Index="4">
                <dl class="summary">
                    <div><dt>Archivo</dt><dd class="mono break">@(_run.ArtifactName ?? "—")</dd></div>
                    <div><dt>SHA-256</dt><dd class="mono break">@(_run.Sha256 ?? "—")</dd></div>
                    <div><dt>Disparador</dt><dd>@(_run.Trigger == RunTrigger.Scheduled ? "Programado" : "Manual")</dd></div>
                    <div><dt>Finalizó</dt><dd>@Display.DateTime(_run.FinishedAt)</dd></div>
                </dl>
            </Card>

            @if (CurrentUser.CanManage && ArtifactService.HasArtifact(_run))
            {
                <Card Index="5" Class="artifact-card">
                    <header class="card__header">
                        <h2 class="card__title">Respaldo</h2>
                        <div class="card__actions">
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Icon="download" Busy="@(_busy == "raw")"
                                    Disabled="_busy is not null" OnClick="() => DownloadAsync(decoded: false)">
                                @(Artifacts.IsTransformed(_run) ? "Descargar tal cual" : "Descargar")
                            </Button>
                            @if (Artifacts.IsTransformed(_run))
                            {
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Icon="download" Busy="@(_busy == "decoded")"
                                        Disabled="_busy is not null" OnClick="() => DownloadAsync(decoded: true)"
                                        Title="Descifrado y descomprimido">Descargar @Artifacts.DecodedName(_run)</Button>
                            }
                            @if (Restores.TargetsFor(_run).Count > 0)
                            {
                                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Icon="refresh"
                                        Href="@($"/runs/{_run.Id}/restore")">Restaurar</Button>
                            }
                            @if (_contents is null)
                            {
                                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Icon="search" Busy="@(_busy == "contents")"
                                        Disabled="_busy is not null" OnClick="LoadContentsAsync">Ver contenido</Button>
                            }
                        </div>
                    </header>

                    @if (_busy is not null)
                    {
                        <p class="muted artifact-card__status"><Spinner Size="14" /> Descargando del destino y verificando el respaldo...</p>
                    }

                    @if (_artifactError is not null)
                    {
                        <div class="callout callout--danger animate-in"><Icon Name="alert" Size="16" /> <span>@_artifactError</span></div>
                    }

                    @if (_contents is { } contents)
                    {
                        @switch (contents.Kind)
                        {
                            case ArtifactContentKind.None:
                                <p class="muted">Este tipo de respaldo (@System.IO.Path.GetExtension(Artifacts.DecodedName(_run))) no se puede listar aquí; descárgalo para revisarlo.</p>
                                break;
                            default:
                                <div class="artifact-card__toolbar">
                                    <TextInput Icon="search" Placeholder="@(contents.Kind == ArtifactContentKind.Archive ? "Buscar archivos..." : "Buscar tablas u objetos...")"
                                               Immediate @bind-Value="_filter" />
                                    <span class="muted">@FilteredEntries.Count() de @contents.Entries.Count @(contents.Kind == ArtifactContentKind.Archive ? "archivos" : "objetos")</span>
                                </div>
                                <div class="table-wrap artifact-card__list">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>@(contents.Kind == ArtifactContentKind.Archive ? "Archivo" : "Objeto")</th>
                                                @if (contents.Kind == ArtifactContentKind.Archive)
                                                {
                                                    <th>Tamaño</th>
                                                    <th>Modificado</th>
                                                    <th></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in FilteredEntries.Take(MaxEntries))
                                            {
                                                <tr>
                                                    <td class="mono break">@entry.Path</td>
                                                    @if (contents.Kind == ArtifactContentKind.Archive)
                                                    {
                                                        <td class="muted">@ByteSize.Format(entry.Size ?? 0)</td>
                                                        <td class="muted">@Display.DateTime(entry.Modified)</td>
                                                        <td class="table__actions">
                                                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Icon="download" IconOnly Title="Descargar"
                                                                    AriaLabel="@($"Descargar {entry.Path}")" Href="@EntryUrl(entry)" download data-enhance-nav="false" />
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (FilteredEntries.Count() > MaxEntries)
                                {
                                    <p class="muted">Mostrando @MaxEntries. Usa el buscador para acotar.</p>
                                }
                                break;
                        }
                    }
                </Card>
            }

            <Card Index="6" Class="log-card">
                <header class="card__header">
                    <h2 class="card__title">Bitácora</h2>
                    <div class="card__actions">
                        @if (_run.Status == RunStatus.Running)
                        {
                            <Badge Tone="Tone.Info" Dot Pulse>En vivo</Badge>
                        }
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Icon="copy" OnClick="CopyLog">Copiar</Button>
                        @if (_run.Status != RunStatus.Running)
                        {
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Icon="download"
                                    Href="@($"/runs/{_run.Id}/log")" download data-enhance-nav="false">Descargar log</Button>
                        }
                    </div>
                </header>
                <pre class="log">@foreach (var line in _run.Log.Split('\n', StringSplitOptions.RemoveEmptyEntries))
{<span class="log__line @LineClass(line)">@line</span>
}</pre>
            </Card>
        }
    </ChildContent>
</PageTemplate>

<ConfirmDialog @bind-Visible="_confirmDelete" Danger Title="¿Eliminar ejecución?" ConfirmText="Eliminar"
               Message="Se borrará definitivamente del historial, con su bitácora. El respaldo guardado en el destino no se borra."
               OnConfirm="Delete" />

@code {
    [Parameter] public Guid Id { get; set; }

    private BackupRun? _run;
    private bool _notFound;
    private bool _confirmDelete;
    private const int MaxEntries = 500;
    private ArtifactContents? _contents;
    private string? _artifactError;
    private string? _busy;
    private string? _filter;

    private IEnumerable<ArtifactEntry> FilteredEntries => string.IsNullOrWhiteSpace(_filter)
        ? _contents?.Entries ?? []
        : (_contents?.Entries ?? []).Where(e => e.Path.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private string EntryUrl(ArtifactEntry entry) => $"/runs/{Id}/artifact/entry?path={Uri.EscapeDataString(entry.Path)}";

    /// <summary>Prepara el archivo aquí (con progreso y errores visibles) y luego lo entrega el endpoint desde la caché.</summary>
    private async Task DownloadAsync(bool decoded)
    {
        _busy = decoded ? "decoded" : "raw";
        _artifactError = null;
        try
        {
            await Artifacts.PrepareAsync(Id, CurrentUser.TenantId, decoded);
            Navigation.NavigateTo($"/runs/{Id}/artifact?decoded={(decoded ? "true" : "false")}", forceLoad: true);
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException)
        {
            _artifactError = ex.Message;
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task LoadContentsAsync()
    {
        _busy = "contents";
        _artifactError = null;
        try
        {
            _contents = await Artifacts.GetContentsAsync(Id);
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException)
        {
            _artifactError = ex.Message;
        }
        finally
        {
            _busy = null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _run = await Dashboard.GetRunAsync(Id);
        _notFound = _run is null;
    }

    protected override async Task OnRunChangedAsync(BackupRun run)
    {
        if (run.Id == Id)
        {
            _run = await Dashboard.GetRunAsync(Id);
        }
    }

    private static string? LineClass(string line) =>
        line.Contains(" ERR ", StringComparison.Ordinal) ? "log__line--error"
        : line.Contains(" WRN ", StringComparison.Ordinal) ? "log__line--warn"
        : null;

    private async Task Cancel()
    {
        if (_run is not null && await JobService.CancelAsync(_run.JobId))
        {
            Toasts.Info("Cancelando ejecución...");
        }
    }

    private async Task CopyLog()
    {
        if (_run is not null && await JS.InvokeAsync<bool>("backupClipboard.copy", _run.Log))
        {
            Toasts.Success("Bitácora copiada");
        }
        else
        {
            Toasts.Error("No se pudo copiar", "Usa Descargar log.");
        }
    }

    private async Task Delete()
    {
        if (_run is null)
        {
            return;
        }

        if (await JobService.DeleteRunAsync(_run.Id))
        {
            Toasts.Success("Ejecución eliminada", _run.JobName);
            Navigation.NavigateTo("/runs");
        }
        else
        {
            Toasts.Error("No se pudo eliminar", "La ejecución sigue en curso o ya no existe.");
        }
    }

    private async Task RunAgain()
    {
        if (_run is null)
        {
            return;
        }

        if (await JobService.RunNowAsync(_run.JobId))
        {
            Toasts.Info("Respaldo en cola", _run.JobName);
        }
        else
        {
            Toasts.Error("Ya está en ejecución", _run.JobName);
        }
    }
}
