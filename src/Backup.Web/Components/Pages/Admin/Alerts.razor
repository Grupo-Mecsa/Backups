@page "/admin/alerts"
@attribute [Authorize(Policy = AppPolicies.CanManage)]
@using Backup.Application.Notifications
@using Backup.Domain.Notifications
@using Backup.Application.WhatsApp
@inject NotificationService Notifications
@inject ToastService Toasts

<PageTemplate Title="Alertas" Subtitle="Avisos por correo, WhatsApp y Telegram cuando un respaldo falla (o también cuando termina bien)">
    <ChildContent>
        @if (_settings is null)
        {
            <div class="skeleton skeleton--card"></div>
        }
        else
        {
            <Card Class="editor" Animate="false">
                <div class="options">
                    <section class="options__section">
                        <header class="options__header">
                            <Icon Name="mail" /> <h3>Correo</h3>
                            <Toggle @bind-Value="_settings.Enabled" Label="@(_settings.Enabled ? "Activadas" : "Desactivadas")" />
                        </header>
                        <div class="form-grid">
                            <FormField Label="Avisar cuando">
                                <div class="stack">
                                    <Toggle @bind-Value="_settings.NotifyOnFailure" Label="Un respaldo falla o se cancela" />
                                    <Toggle @bind-Value="_settings.NotifyOnSuccess" Label="Un respaldo termina correctamente" />
                                </div>
                            </FormField>
                            <FormField Label="Destinatarios" For="recipients" Required Error="@ErrorFor(nameof(NotificationSettings.Recipients))"
                                       Help="Separados por coma o uno por línea." Class="field--wide">
                                <TextInput Id="recipients" Multiline Rows="2" @bind-Value="_settings.Recipients" Placeholder="soporte@empresa.com, ti@empresa.com" />
                            </FormField>
                        </div>
                    </section>

                    <section class="options__section">
                        <header class="options__header">
                            <Icon Name="server" /> <h3>Servidor SMTP</h3>
                        </header>
                        @if (Notifications.PlatformSender is { } platformSender)
                        {
                            <Toggle @bind-Value="_settings.UsePlatformSmtp" Label="@($"Usar el servidor de la plataforma (envía como {platformSender})")" />
                        }
                        @if (ErrorFor(nameof(NotificationSettings.UsePlatformSmtp)) is { } platformError)
                        {
                            <div class="callout callout--danger"><Icon Name="alert" Size="16" /> <span>@platformError</span></div>
                        }
                        @if (!_settings.UsePlatformSmtp)
                        {
                        <div class="chips">
                            @foreach (var preset in Presets)
                            {
                                <button type="button" class="chip" @onclick="() => ApplyPreset(preset)"><Icon Name="zap" Size="14" /> @preset.Name</button>
                            }
                        </div>
                        <div class="form-grid">
                            <FormField Label="Servidor" For="host" Required Error="@ErrorFor(nameof(NotificationSettings.SmtpHost))">
                                <TextInput Id="host" @bind-Value="_settings.SmtpHost" Placeholder="smtp.office365.com" />
                            </FormField>
                            <FormField Label="Puerto" For="port" Error="@ErrorFor(nameof(NotificationSettings.SmtpPort))">
                                <TextInput Id="port" Type="number" Min="1" Value="@_settings.SmtpPort.ToString()" ValueChanged="SetPort" />
                            </FormField>
                            <FormField Label="Seguridad" For="security" Help="587 → STARTTLS · 465 → SSL/TLS · 25 → ninguna.">
                                <SelectInput Id="security" Options="SecurityOptions" Value="@_settings.Security.ToString()" ValueChanged="SetSecurity" />
                            </FormField>
                            <FormField Label="Usuario" For="smtp-user" Help="Vacío si el servidor no requiere autenticación.">
                                <TextInput Id="smtp-user" @bind-Value="_settings.Username" Placeholder="alertas@empresa.com" />
                            </FormField>
                            <FormField Label="Contraseña" For="smtp-pass" Hint="@(_hasPassword ? "guardada" : null)">
                                <TextInput Id="smtp-pass" Type="password" @bind-Value="_settings.Password"
                                           Placeholder="@(_hasPassword ? "•••••••• (sin cambios)" : null)" />
                            </FormField>
                            <FormField Label="Remitente" For="from" Required Error="@ErrorFor(nameof(NotificationSettings.FromAddress))">
                                <TextInput Id="from" Type="email" @bind-Value="_settings.FromAddress" Placeholder="alertas@empresa.com" />
                            </FormField>
                            <FormField Label="Nombre del remitente" For="from-name">
                                <TextInput Id="from-name" Value="@_settings.FromName" ValueChanged="v => _settings.FromName = v ?? string.Empty" />
                            </FormField>
                        </div>
                        }
                    </section>
                </div>

                @if (_testResult is not null)
                {
                    <div class="callout callout--@(_testResult.Success ? "success" : "danger") animate-in"><Icon Name="@(_testResult.Success ? "check" : "alert")" Size="16" /> <span>@_testResult.Message</span></div>
                }

                <footer class="editor__footer">
                    <Button Variant="ButtonVariant.Secondary" Icon="send" Busy="_testing" OnClick="SendTest">Enviar correo de prueba</Button>
                    <span class="spacer"></span>
                    <Button Icon="check" Busy="_saving" OnClick="Save">Guardar</Button>
                </footer>
            </Card>

            <Card Class="editor" Animate="false">
                <div class="options">
                    <section class="options__section">
                        <header class="options__header">
                            <Icon Name="whatsapp" /> <h3>WhatsApp</h3>
                            <Toggle @bind-Value="_settings.WhatsAppEnabled" Label="@(_settings.WhatsAppEnabled ? "Activadas" : "Desactivadas")" />
                        </header>
                        <div class="form-grid">
                            <FormField Label="Avisar cuando">
                                <div class="stack">
                                    <Toggle @bind-Value="_settings.WhatsAppOnFailure" Label="Un respaldo falla, se cancela o termina con advertencias" />
                                    <Toggle @bind-Value="_settings.WhatsAppOnSuccess" Label="Un respaldo termina correctamente" />
                                </div>
                            </FormField>
                            <FormField Label="Destinatarios" For="wa-recipients" Required="_settings.WhatsAppEnabled" Error="@ErrorFor(nameof(NotificationSettings.WhatsAppRecipients))"
                                       Help="Números con código de país o grupos (usa «Agregar grupo»). Uno por línea o separados por coma." Class="field--wide">
                                <TextInput Id="wa-recipients" Multiline Rows="3" @bind-Value="_settings.WhatsAppRecipients" Placeholder="+506 7070 7070, +506 8888 8888" />
                            </FormField>
                        </div>
                    </section>

                    <section class="options__section">
                        <header class="options__header">
                            <Icon Name="server" /> <h3>Conexión con WAHA</h3>
                        </header>
                        @if (Notifications.PlatformWhatsApp is { } platformWhatsApp)
                        {
                            <Toggle Value="_settings.UsePlatformWhatsApp" ValueChanged="SetUsePlatformWhatsApp" Label="@($"Usar la instancia de la plataforma ({platformWhatsApp})")" />
                        }
                        @if (ErrorFor(nameof(NotificationSettings.UsePlatformWhatsApp)) is { } platformWhatsAppError)
                        {
                            <div class="callout callout--danger"><Icon Name="alert" Size="16" /> <span>@platformWhatsAppError</span></div>
                        }
                        @if (!_settings.UsePlatformWhatsApp)
                        {
                            <p class="muted editor__lead">
                                <a href="https://waha.devlike.pro" target="_blank" rel="noopener">WAHA</a> (WhatsApp HTTP API) envía los mensajes desde una cuenta de WhatsApp vinculada.
                                La URL debe ser accesible desde el servidor de BackupHub.
                            </p>
                            <div class="form-grid">
                                <FormField Label="URL de WAHA" For="waha-url" Required Error="@ErrorFor(nameof(NotificationSettings.WahaUrl))">
                                    <TextInput Id="waha-url" Value="@_settings.WahaUrl" Placeholder="http://192.168.1.3:3000" ValueChanged="v => { _settings.WahaUrl = v; _whatsAppStatus = null; }" />
                                </FormField>
                                <FormField Label="API key" For="waha-key" Hint="@(_hasWhatsAppKey ? "guardada" : null)" Help="El valor de WAHA_API_KEY de la instancia.">
                                    <TextInput Id="waha-key" Type="password" Value="@_settings.WahaApiKey" ValueChanged="v => { _settings.WahaApiKey = v; _whatsAppStatus = null; }"
                                               Placeholder="@(_hasWhatsAppKey ? "•••••••• (sin cambios)" : null)" />
                                </FormField>
                                <FormField Label="Sesión" For="waha-session" Required Error="@ErrorFor(nameof(NotificationSettings.WahaSession))" Help="Cuenta de WhatsApp desde la que se envía.">
                                    <div class="input-group">
                                        <TextInput Id="waha-session" Value="@_settings.WahaSession" Placeholder="default" ValueChanged="v => { _settings.WahaSession = v; _whatsAppStatus = null; }" />
                                        <Button Variant="ButtonVariant.Secondary" Icon="search" Title="Consultar las sesiones de WAHA" OnClick="() => _sessionsOpen = true">Elegir</Button>
                                    </div>
                                </FormField>
                            </div>
                        }
                        <div class="settings-form__footer">
                            <Button Variant="ButtonVariant.Secondary" Icon="plug" Busy="_checkingWhatsApp" OnClick="TestWhatsApp">Probar conexión</Button>
                            @if (_whatsAppStatus is not null)
                            {
                                <div class="callout callout--@(_whatsAppStatus.Success ? "success" : "danger") animate-in" role="status">
                                    <Icon Name="@(_whatsAppStatus.Success ? "check" : "alert")" Size="16" /> <span>@_whatsAppStatus.Message</span>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                @if (_whatsAppTest is not null)
                {
                    <div class="callout callout--@(_whatsAppTest.Success ? "success" : "danger") animate-in"><Icon Name="@(_whatsAppTest.Success ? "check" : "alert")" Size="16" /> <span>@_whatsAppTest.Message</span></div>
                }
                <footer class="editor__footer">
                    <Button Variant="ButtonVariant.Secondary" Icon="users" OnClick="() => _groupsOpen = true">Agregar grupo</Button>
                    <Button Variant="ButtonVariant.Secondary" Icon="send" Busy="_testingWhatsApp" OnClick="SendWhatsAppTest">Enviar mensaje de prueba</Button>
                    <span class="spacer"></span>
                    <Button Icon="check" Busy="_saving" OnClick="Save">Guardar</Button>
                </footer>
            </Card>

            <OptionPickerDialog @bind-Visible="_groupsOpen" Title="Agregar un grupo de WhatsApp" Loader="LoadGroups" OnApplied="AddGroup" />
            <OptionPickerDialog @bind-Visible="_sessionsOpen" Title="Elegir la sesión de WAHA" Value="@_settings.WahaSession" Loader="LoadSessions" OnApplied="SetSession" />

            <Card Class="editor" Animate="false">
                <header class="options__header">
                    <Icon Name="send" /> <h3>Telegram</h3>
                </header>
                <p class="muted editor__lead">Chats vinculados a este tenant. Cada usuario conecta el suyo (o un grupo) desde <a href="account/profile">Mi cuenta</a>.</p>
                <TelegramChats TenantWide />
            </Card>
        }
    </ChildContent>
</PageTemplate>

@code {
    private sealed record Preset(string Name, string Host, int Port, SmtpSecurity Security);

    private static readonly Preset[] Presets =
    [
        new("Microsoft 365", "smtp.office365.com", 587, SmtpSecurity.StartTls),
        new("Gmail / Workspace", "smtp.gmail.com", 587, SmtpSecurity.StartTls),
        new("Zoho", "smtp.zoho.com", 465, SmtpSecurity.SslOnConnect),
        new("SendGrid", "smtp.sendgrid.net", 587, SmtpSecurity.StartTls),
    ];

    private static readonly SelectOption[] SecurityOptions =
    [
        new(nameof(SmtpSecurity.Auto), "Automática"),
        new(nameof(SmtpSecurity.StartTls), "STARTTLS"),
        new(nameof(SmtpSecurity.SslOnConnect), "SSL/TLS"),
        new(nameof(SmtpSecurity.None), "Ninguna"),
    ];

    private NotificationSettings? _settings;
    private bool _hasPassword;
    private bool _saving;
    private bool _testing;
    private ConnectionTestResult? _testResult;
    private IReadOnlyList<ValidationError> _errors = [];

    private bool _groupsOpen;
    private bool _sessionsOpen;
    private bool _testingWhatsApp;
    private bool _checkingWhatsApp;
    private bool _hasWhatsAppKey;
    private ConnectionTestResult? _whatsAppTest;
    private ConnectionTestResult? _whatsAppStatus;

    protected override async Task OnInitializedAsync()
    {
        (_settings, _hasPassword, _hasWhatsAppKey) = await Notifications.GetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El estado de WhatsApp se consulta después de pintar la página: WAHA puede tardar en responder.
        if (firstRender && _settings is not null && _settings.WhatsAppEnabled
            && (_settings.UsePlatformWhatsApp || !string.IsNullOrWhiteSpace(_settings.WahaUrl)))
        {
            await TestWhatsApp();
            StateHasChanged();
        }
    }

    private void SetUsePlatformWhatsApp(bool value)
    {
        _settings!.UsePlatformWhatsApp = value;
        _whatsAppStatus = null;
    }

    private async Task TestWhatsApp()
    {
        _checkingWhatsApp = true;
        _whatsAppStatus = null;
        try
        {
            _whatsAppStatus = await Notifications.TestWhatsAppAsync(Copy());
        }
        finally
        {
            _checkingWhatsApp = false;
        }
    }

    private async Task<OptionsResult> LoadSessions()
    {
        try
        {
            var sessions = await Notifications.ListWhatsAppSessionsAsync(Copy());
            return sessions.Count == 0
                ? OptionsResult.Fail("WAHA no tiene sesiones. Crea una y vincula WhatsApp desde su panel.")
                : OptionsResult.Ok([.. sessions.Select(s => s.Name)]);
        }
#pragma warning disable CA1031 // El error se muestra en el diálogo
        catch (Exception ex)
#pragma warning restore CA1031
        {
            return OptionsResult.Fail(ex.Message);
        }
    }

    private async Task SetSession(string? session)
    {
        _settings!.WahaSession = session;
        await TestWhatsApp();
    }

    private async Task<OptionsResult> LoadGroups()
    {
        try
        {
            var groups = await Notifications.ListWhatsAppGroupsAsync(Copy());
            return groups.Count == 0
                ? OptionsResult.Fail("La cuenta de WhatsApp no está en ningún grupo. Agrégala al grupo y vuelve a intentarlo.")
                : OptionsResult.Ok([.. groups.Select(WhatsAppRecipients.Format)]);
        }
#pragma warning disable CA1031 // El error se muestra en el diálogo
        catch (Exception ex)
#pragma warning restore CA1031
        {
            return OptionsResult.Fail(ex.Message);
        }
    }

    private void AddGroup(string? group)
    {
        if (string.IsNullOrWhiteSpace(group) || _settings!.WhatsAppRecipientList.Contains(group))
        {
            return;
        }

        _settings.WhatsAppRecipients = string.Join('\n', [.. _settings.WhatsAppRecipientList, group]);
    }

    private async Task SendWhatsAppTest()
    {
        _testingWhatsApp = true;
        _whatsAppTest = null;
        try
        {
            _whatsAppTest = await Notifications.SendWhatsAppTestAsync(Copy());
        }
        finally
        {
            _testingWhatsApp = false;
        }
    }

    private string? ErrorFor(string field) => _errors.FirstOrDefault(e => e.Field == field)?.Message;

    private void SetPort(string? value) => _settings!.SmtpPort = int.TryParse(value, out var port) ? port : 0;

    private void SetSecurity(string? value) => _settings!.Security = Enum.TryParse<SmtpSecurity>(value, out var security) ? security : SmtpSecurity.Auto;

    private void ApplyPreset(Preset preset)
    {
        _settings!.SmtpHost = preset.Host;
        _settings.SmtpPort = preset.Port;
        _settings.Security = preset.Security;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            _errors = await Notifications.SaveAsync(Copy());
            if (_errors.Count == 0)
            {
                Toasts.Success("Alertas guardadas");
                (_settings, _hasPassword, _hasWhatsAppKey) = await Notifications.GetAsync();
            }
            else
            {
                Toasts.Error("Revisa el formulario");
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SendTest()
    {
        _testing = true;
        _testResult = null;
        try
        {
            _testResult = await Notifications.SendTestAsync(Copy());
        }
        finally
        {
            _testing = false;
        }
    }

    /// <summary>El servicio modifica la instancia (p. ej. rellena la contraseña guardada); se trabaja sobre una copia.</summary>
    private NotificationSettings Copy() => new()
    {
        Enabled = _settings!.Enabled,
        UsePlatformSmtp = _settings.UsePlatformSmtp,
        SmtpHost = _settings.SmtpHost,
        SmtpPort = _settings.SmtpPort,
        Security = _settings.Security,
        Username = _settings.Username,
        Password = _settings.Password,
        FromAddress = _settings.FromAddress,
        FromName = _settings.FromName,
        Recipients = _settings.Recipients,
        NotifyOnFailure = _settings.NotifyOnFailure,
        NotifyOnSuccess = _settings.NotifyOnSuccess,
        WhatsAppEnabled = _settings.WhatsAppEnabled,
        WhatsAppRecipients = _settings.WhatsAppRecipients,
        WhatsAppOnFailure = _settings.WhatsAppOnFailure,
        WhatsAppOnSuccess = _settings.WhatsAppOnSuccess,
        UsePlatformWhatsApp = _settings.UsePlatformWhatsApp,
        WahaUrl = _settings.WahaUrl,
        WahaApiKey = _settings.WahaApiKey,
        WahaSession = _settings.WahaSession,
    };
}
