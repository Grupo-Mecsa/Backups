@page "/jobs/new"
@attribute [Authorize(Policy = AppPolicies.CanManage)]
@page "/jobs/{Id:guid}"
@inject JobService JobService
@inject RestoreService Restores
@inject IProviderRegistry Registry
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTemplate Title="@(_draft?.IsNew == false ? $"Editar: {_job.Name}" : "Nuevo trabajo")"
              Subtitle="Configura el origen, el destino y la frecuencia del respaldo"
              BackHref="/jobs" BackLabel="Trabajos">
    <ChildContent>
        @if (_draft is null)
        {
            @if (_notFound)
            {
                <EmptyState Icon="alert" Title="Trabajo no encontrado">
                    <Button Href="/jobs" Variant="ButtonVariant.Secondary">Volver a trabajos</Button>
                </EmptyState>
            }
            else
            {
                <div class="skeleton skeleton--card"></div>
            }
        }
        else
        {
            <StepIndicator Steps="Steps" Current="_step" ErrorSteps="_errorSteps" OnSelect="GoTo" />

            <Card Class="editor" Animate="false">
                <div class="editor__step" @key="_step">
                    @switch (_step)
                    {
                        case 0:
                            <h2 class="editor__title">Información general</h2>
                            <div class="form-grid">
                                <FormField Label="Nombre" For="name" Required Error="@ErrorFor("Name")"
                                           Help="@FolderHelp">
                                    <TextInput Id="name" @bind-Value="_job.Name" Placeholder="ERP producción" Invalid="@(ErrorFor("Name") is not null)" />
                                </FormField>
                                <FormField Label="Estado" Help="Un trabajo pausado no se ejecuta según su horario.">
                                    <Toggle @bind-Value="_job.Enabled" Label="@(_job.Enabled ? "Activo" : "Pausado")" />
                                </FormField>
                                <FormField Label="Descripción" For="description" Class="field--wide">
                                    <TextInput Id="description" Multiline Rows="2" @bind-Value="_job.Description" Placeholder="Opcional" />
                                </FormField>
                            </div>
                            break;

                        case 1:
                            <h2 class="editor__title">¿Qué quieres respaldar?</h2>
                            @if (ErrorFor("Source") is { } sourceError)
                            {
                                <div class="callout callout--danger"><Icon Name="alert" Size="16" /> @sourceError</div>
                            }
                            <ProviderPicker Providers="Registry.Sources" SelectedKey="@_job.Source.ProviderKey"
                                            SelectedKeyChanged="key => SelectProvider(ProviderRole.Source, key)" />
                            @if (Registry.Find(ProviderRole.Source, _job.Source.ProviderKey) is { } source)
                            {
                                <ProviderSettingsForm Provider="source" Binding="_job.Source" ErrorPrefix="Source" Errors="_errors"
                                                      FieldFilter="FieldsFor(_job.Source)"
                                                      HasStoredSecret="key => HasStoredSecret(ProviderRole.Source, key)"
                                                      OnTestHandler="() => Test(ProviderRole.Source)"
                                                      OnBrowseHandler="path => Browse(ProviderRole.Source, path)"
                                                      OnListHandler="key => ListOptions(ProviderRole.Source, key)"
                                                      OnCreateFolderHandler="(parent, name) => CreateFolder(ProviderRole.Source, parent, name)">
                                    @if (source.Descriptor.SupportsConnections)
                                    {
                                        <ConnectionChooser Binding="_job.Source" IdPrefix="source"
                                                           @bind-SaveAsNew="_saveSourceConnection" @bind-NewName="_sourceConnectionName"
                                                           NameError="@ErrorFor("Source.Connection.Name")" />
                                    }
                                </ProviderSettingsForm>
                            }
                            break;

                        case 2:
                            <h2 class="editor__title">¿A dónde se envía?</h2>
                            @if (ErrorFor("Destination") is { } destinationError)
                            {
                                <div class="callout callout--danger"><Icon Name="alert" Size="16" /> @destinationError</div>
                            }
                            <ProviderPicker Providers="Registry.Destinations" SelectedKey="@_job.Destination.ProviderKey"
                                            SelectedKeyChanged="key => SelectProvider(ProviderRole.Destination, key)" />
                            @if (Registry.Find(ProviderRole.Destination, _job.Destination.ProviderKey) is { } destination)
                            {
                                <ProviderSettingsForm Provider="destination" Binding="_job.Destination" ErrorPrefix="Destination" Errors="_errors"
                                                      FieldFilter="FieldsFor(_job.Destination)"
                                                      HasStoredSecret="key => HasStoredSecret(ProviderRole.Destination, key)"
                                                      OnTestHandler="() => Test(ProviderRole.Destination)"
                                                      OnBrowseHandler="path => Browse(ProviderRole.Destination, path)"
                                                      OnListHandler="key => ListOptions(ProviderRole.Destination, key)"
                                                      OnCreateFolderHandler="(parent, name) => CreateFolder(ProviderRole.Destination, parent, name)">
                                    @if (destination.Descriptor.SupportsConnections)
                                    {
                                        <ConnectionChooser Binding="_job.Destination" IdPrefix="destination"
                                                           @bind-SaveAsNew="_saveDestinationConnection" @bind-NewName="_destinationConnectionName"
                                                           NameError="@ErrorFor("Destination.Connection.Name")" />
                                    }
                                </ProviderSettingsForm>
                            }
                            break;

                        case 3:
                            <h2 class="editor__title">¿Cuándo se ejecuta?</h2>
                            <ScheduleEditor @bind-Schedule="_job.Schedule" @bind-TimeZone="_job.TimeZone" Error="@ErrorFor("Schedule")" />
                            break;

                        case 4:
                            <h2 class="editor__title">Opciones</h2>
                            <JobOptionsEditor Job="_job" @bind-EncryptEnabled="_encrypt" @bind-Passphrase="_passphrase"
                                              HasStoredPassphrase="_draft.HasStoredSecret(JobSecrets.EncryptionKey)" Errors="_errors" />
                            break;

                        case 5:
                            <h2 class="editor__title">¿Dónde se restaura?</h2>
                            <p class="editor__hint">Opcional. Es el destino que vendrá elegido al pulsar «Restaurar» en el historial; ahí se puede cambiar, o restaurar en el origen.</p>
                            <Toggle Value="_job.RestoreTarget is not null" ValueChanged="SetRestoreEnabled" Label="Definir un destino de restauración predeterminado" />
                            @if (_job.RestoreTarget is { } restoreTarget)
                            {
                                @if (ErrorFor("Restore") is { } restoreError)
                                {
                                    <div class="callout callout--danger"><Icon Name="alert" Size="16" /> @restoreError</div>
                                }
                                <ProviderPicker Providers="RestoreTargets" SelectedKey="@restoreTarget.ProviderKey" SelectedKeyChanged="SelectRestoreProvider" />
                                @if (RestoreTargets.FirstOrDefault(t => string.Equals(t.Descriptor.Key, restoreTarget.ProviderKey, StringComparison.OrdinalIgnoreCase)) is { } restoreProvider)
                                {
                                    <ProviderSettingsForm Provider="restoreProvider" Binding="restoreTarget" ErrorPrefix="Restore" Errors="_errors"
                                                          Fields="restoreProvider.RestoreFields"
                                                          FieldFilter="@(restoreTarget.ConnectionId is null ? null : f => !f.IsConnection)"
                                                          HasStoredSecret="HasStoredRestoreSecret"
                                                          OnTestHandler="() => Restores.TestAsync(restoreTarget, RestoreSecrets)"
                                                          OnBrowseHandler="path => Restores.BrowseAsync(restoreTarget, RestoreSecrets, path)"
                                                          OnListHandler="key => Restores.ListOptionsAsync(restoreTarget, RestoreSecrets, key)"
                                                          OnCreateFolderHandler="(parent, name) => Restores.CreateFolderAsync(restoreTarget, RestoreSecrets, parent, name)">
                                        @if (restoreProvider.Descriptor.SupportsConnections)
                                        {
                                            <ConnectionChooser Binding="restoreTarget" IdPrefix="restore" AllowSave="false" />
                                        }
                                    </ProviderSettingsForm>
                                }
                            }
                            break;

                        default:
                            <h2 class="editor__title">Resumen</h2>
                            <dl class="summary">
                                <div><dt>Nombre</dt><dd>@(_job.Name is { Length: > 0 } ? _job.Name : "—")</dd></div>
                                <div><dt>Origen</dt><dd>@(Registry.Find(ProviderRole.Source, _job.Source.ProviderKey)?.Descriptor.DisplayName ?? "—")@ConnectionNote(_job.Source, _saveSourceConnection)</dd></div>
                                <div><dt>Destino</dt><dd>@(Registry.Find(ProviderRole.Destination, _job.Destination.ProviderKey)?.Descriptor.DisplayName ?? "—")@ConnectionNote(_job.Destination, _saveDestinationConnection)</dd></div>
                                <div><dt>Horario</dt><dd class="mono">@(_job.Schedule ?? "Manual") <span class="muted">(@_job.TimeZone)</span></dd></div>
                                <div><dt>Compresión</dt><dd>@_job.Compression</dd></div>
                                <div><dt>Cifrado</dt><dd>@(_encrypt ? "AES-256" : "No")</dd></div>
                                <div><dt>Restauración</dt><dd>@(_job.RestoreTarget is { } rt && Restores.TargetsForSource(_job.Source).FirstOrDefault(t => t.Descriptor.Key == rt.ProviderKey) is { } rp ? rp.Descriptor.DisplayName : "Se elige al restaurar")</dd></div>
                                <div><dt>Retención</dt><dd>Últimos @_job.Retention.KeepLast · @_job.Retention.KeepDays días</dd></div>
                                <div><dt>Estado</dt><dd>@(_job.Enabled ? "Activo" : "Pausado")</dd></div>
                            </dl>
                            @if (_errors.Count > 0)
                            {
                                <div class="callout callout--danger">
                                    <Icon Name="alert" Size="16" />
                                    <ul class="plain-list">
                                        @foreach (var error in _errors)
                                        {
                                            <li>@error.Message</li>
                                        }
                                    </ul>
                                </div>
                            }
                            break;
                    }
                </div>

                <footer class="editor__footer">
                    <Button Variant="ButtonVariant.Secondary" Icon="chevron-left" Disabled="_step == 0" OnClick="() => GoTo(_step - 1)">Atrás</Button>
                    <span class="spacer"></span>
                    @if (_step < Steps.Length - 1)
                    {
                        @if (!_draft.IsNew)
                        {
                            <Button Variant="ButtonVariant.Ghost" Icon="check" Busy="_saving" OnClick="Save">Guardar</Button>
                        }
                        <Button IconAfter="chevron-right" OnClick="() => GoTo(_step + 1)">Siguiente</Button>
                    }
                    else
                    {
                        <Button Icon="check" Busy="_saving" OnClick="Save">@(_draft.IsNew ? "Crear trabajo" : "Guardar cambios")</Button>
                    }
                </footer>
            </Card>
        }
    </ChildContent>
</PageTemplate>

@code {
    private static readonly string[] Steps = ["General", "Origen", "Destino", "Programación", "Opciones", "Restauración", "Resumen"];

    [Parameter] public Guid? Id { get; set; }

    private JobDraft? _draft;
    private BackupJob _job = new();
    private bool _notFound;
    private int _step;
    private bool _saving;
    private bool _encrypt;
    private string? _passphrase;
    private IReadOnlyList<ValidationError> _errors = [];
    private IReadOnlySet<int> _errorSteps = new HashSet<int>();
    private ProviderBinding _originalSource = new();
    private ProviderBinding _originalDestination = new();
    private ProviderBinding? _originalRestore;
    private bool _saveSourceConnection;
    private string? _sourceConnectionName;
    private bool _saveDestinationConnection;
    private string? _destinationConnectionName;

    protected override async Task OnParametersSetAsync()
    {
        _draft = Id is { } id ? await JobService.GetForEditAsync(id) : JobService.NewDraft();
        _notFound = _draft is null;
        if (_draft is null)
        {
            return;
        }

        _job = _draft.Job;
        _encrypt = _draft.HasStoredSecret(JobSecrets.EncryptionKey);
        _originalSource = _job.Source.Clone();
        _originalDestination = _job.Destination.Clone();
        _originalRestore = _job.RestoreTarget?.Clone();
    }

    private string FolderHelp =>
        $"Carpeta en el destino: {Backup.Application.Pipeline.ArtifactNaming.Folder(_job.Name ?? string.Empty)}/";

    /// <summary>Con conexión guardada solo se editan los campos propios del trabajo; los de acceso vienen de ella.</summary>
    private static Func<SettingField, bool>? FieldsFor(ProviderBinding binding) =>
        binding.ConnectionId is null ? null : f => !f.IsConnection;

    private static string? ConnectionNote(ProviderBinding binding, bool savingNew) =>
        binding.ConnectionId is not null ? " · con conexión guardada" : savingNew ? " · se guardará como conexión" : null;

    private IReadOnlyList<IRestoreTarget> RestoreTargets => Restores.TargetsForSource(_job.Source);

    /// <summary>Secretos guardados del destino de restauración de este trabajo (si ya existe).</summary>
    private RestoreSecrets RestoreSecrets => new(_draft!.IsNew ? Guid.Empty : _job.Id, RestorePreset.JobTarget);

    private bool HasStoredRestoreSecret(string key) =>
        _draft!.HasStoredSecret(JobSecrets.RestoreKey(key))
        && string.Equals(_originalRestore?.ProviderKey, _job.RestoreTarget?.ProviderKey, StringComparison.OrdinalIgnoreCase);

    private void SetRestoreEnabled(bool enabled) =>
        _job.RestoreTarget = enabled ? _originalRestore?.Clone() ?? new ProviderBinding() : null;

    private void SelectRestoreProvider(string key)
    {
        if (string.Equals(_originalRestore?.ProviderKey, key, StringComparison.OrdinalIgnoreCase))
        {
            _job.RestoreTarget = _originalRestore!.Clone();
            return;
        }

        var binding = new ProviderBinding { ProviderKey = key };
        foreach (var field in RestoreTargets.First(t => t.Descriptor.Key == key).RestoreFields.Where(f => f.DefaultValue is not null))
        {
            binding.Settings[field.Key] = field.DefaultValue;
        }

        _job.RestoreTarget = binding;
    }

    private void GoTo(int step) => _step = Math.Clamp(step, 0, Steps.Length - 1);

    private string? ErrorFor(string field) => _errors.FirstOrDefault(e => e.Field == field)?.Message;

    private bool HasStoredSecret(ProviderRole role, string key)
    {
        var original = role == ProviderRole.Source ? _originalSource : _originalDestination;
        var current = role == ProviderRole.Source ? _job.Source : _job.Destination;
        return _draft!.HasStoredSecret(JobSecrets.Key(role, key))
            && string.Equals(original.ProviderKey, current.ProviderKey, StringComparison.OrdinalIgnoreCase);
    }

    private void SelectProvider(ProviderRole role, string key)
    {
        var original = role == ProviderRole.Source ? _originalSource : _originalDestination;
        ProviderBinding binding;
        if (string.Equals(original.ProviderKey, key, StringComparison.OrdinalIgnoreCase))
        {
            binding = original.Clone();
        }
        else
        {
            binding = new ProviderBinding { ProviderKey = key };
            foreach (var field in Registry.Find(role, key)!.Descriptor.Fields.Where(f => f.DefaultValue is not null))
            {
                binding.Settings[field.Key] = field.DefaultValue;
            }
        }

        if (role == ProviderRole.Source)
        {
            _job.Source = binding;
        }
        else
        {
            _job.Destination = binding;
        }
    }

    private Task<ConnectionTestResult> Test(ProviderRole role) =>
        JobService.TestConnectionAsync(role, role == ProviderRole.Source ? _job.Source : _job.Destination, _draft!.IsNew ? null : _job.Id);

    private Task<BrowseResult> Browse(ProviderRole role, string? path) =>
        JobService.BrowseAsync(role, role == ProviderRole.Source ? _job.Source : _job.Destination, _draft!.IsNew ? null : _job.Id, path);

    private Task<CreateFolderResult> CreateFolder(ProviderRole role, string parent, string name) =>
        JobService.CreateFolderAsync(role, role == ProviderRole.Source ? _job.Source : _job.Destination, _draft!.IsNew ? null : _job.Id, parent, name);

    private Task<OptionsResult> ListOptions(ProviderRole role, string fieldKey) =>
        JobService.ListOptionsAsync(role, role == ProviderRole.Source ? _job.Source : _job.Destination, _draft!.IsNew ? null : _job.Id, fieldKey);

    private async Task Save()
    {
        _saving = true;
        try
        {
            var errors = new List<ValidationError>();
            if (_encrypt && string.IsNullOrEmpty(_passphrase) && !_draft!.HasStoredSecret(JobSecrets.EncryptionKey))
            {
                errors.Add(new(nameof(BackupJob.EncryptionPassphrase), "Indica la contraseña de cifrado."));
            }

            if (errors.Count == 0)
            {
                await SaveNewConnectionAsync(ProviderRole.Source, errors);
                await SaveNewConnectionAsync(ProviderRole.Destination, errors);
            }

            if (errors.Count == 0)
            {
                _job.EncryptionPassphrase = _encrypt && !string.IsNullOrEmpty(_passphrase) ? _passphrase : null;
                var result = await JobService.SaveAsync(_job, keepEncryption: _encrypt);
                if (result.Success)
                {
                    Toasts.Success(_draft!.IsNew ? "Trabajo creado" : "Cambios guardados", _job.Name);
                    Navigation.NavigateTo("/jobs");
                    return;
                }

                errors.AddRange(result.Errors);
            }

            _errors = errors;
            _errorSteps = errors.Select(e => StepOf(e.Field)).ToHashSet();
            _step = _errorSteps.Min();
            Toasts.Error("Revisa el formulario", $"{errors.Count} problema(s) encontrados.");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Si se pidió "guardar como conexión", la crea con los datos de acceso escritos y hace que el trabajo la use.
    /// </summary>
    private async Task SaveNewConnectionAsync(ProviderRole role, List<ValidationError> errors)
    {
        var source = role == ProviderRole.Source;
        var binding = source ? _job.Source : _job.Destination;
        var wanted = source ? _saveSourceConnection : _saveDestinationConnection;
        if (!wanted || binding.ConnectionId is not null || Registry.Find(role, binding.ProviderKey) is not { Descriptor.SupportsConnections: true })
        {
            return;
        }

        var prefix = source ? "Source" : "Destination";
        var name = (source ? _sourceConnectionName : _destinationConnectionName)?.Trim();
        if (string.IsNullOrEmpty(name))
        {
            errors.Add(new($"{prefix}.Connection.Name", "Indica un nombre para la conexión."));
            return;
        }

        var result = await JobService.SaveAsConnectionAsync(role, binding, _draft!.IsNew ? null : _job.Id, name);
        if (!result.Success)
        {
            // "Connection.Settings.host" → "Source.host" para que el error aparezca junto a su campo.
            errors.AddRange(result.Errors.Select(e => e with
            {
                Field = e.Field.StartsWith("Connection.Settings.", StringComparison.Ordinal)
                    ? $"{prefix}.{e.Field["Connection.Settings.".Length..]}"
                    : $"{prefix}.{e.Field}",
            }));
            return;
        }

        binding.ConnectionId = result.ConnectionId;
        if (source)
        {
            _saveSourceConnection = false;
        }
        else
        {
            _saveDestinationConnection = false;
        }

        Toasts.Info("Conexión guardada", name);
    }

    private static int StepOf(string field) => field switch
    {
        "Name" => 0,
        _ when field.StartsWith("Source", StringComparison.Ordinal) => 1,
        _ when field.StartsWith("Destination", StringComparison.Ordinal) => 2,
        "Schedule" => 3,
        _ when field.StartsWith("Restore", StringComparison.Ordinal) => 5,
        _ => 4,
    };
}
