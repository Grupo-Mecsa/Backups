@page "/account/forgot-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Backup.Infrastructure.Identity
@inject PasswordRecovery Recovery

<PageTitle>Recuperar contraseña · BackupHub</PageTitle>

<h1 class="auth__title">Recuperar contraseña</h1>
<p class="auth__subtitle">Te enviaremos un enlace para elegir una nueva.</p>

@if (_sent)
{
    <div class="callout callout--success animate-in" role="status">
        <Icon Name="mail" Size="16" />
        <span>Si <strong>@Input.Email</strong> corresponde a una cuenta, recibirás un correo en unos minutos. Revisa también la carpeta de spam.</span>
    </div>
}
else
{
    <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot-password" class="auth__form">
        <DataAnnotationsValidator />
        <FormField Label="Correo" For="email">
            <InputText id="email" type="email" class="input" autocomplete="username" placeholder="tu@empresa.com" @bind-Value="Input.Email" />
            <ValidationMessage For="() => Input.Email" class="field__error" />
        </FormField>
        <button type="submit" class="btn btn--primary btn--lg auth__submit">
            <Icon Name="send" Size="16" /> <span class="btn__label">Enviar enlace</span>
        </button>
    </EditForm>
}

<p class="auth__footer"><a class="auth__link" href="account/login">Volver a iniciar sesión</a></p>

@code {
    private bool _sent;

    [SupplyParameterFromForm] private ForgotModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        // Siempre la misma respuesta, exista o no la cuenta.
        await Recovery.RequestResetAsync(Input!.Email);
        _sent = true;
    }

    private sealed class ForgotModel
    {
        [Required(ErrorMessage = "Indica tu correo."), EmailAddress(ErrorMessage = "Correo no válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
