@page "/account/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Backup.Application.Abstractions
@using Backup.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignIn
@inject UserManager<ApplicationUser> Users
@inject ITenantRepository Tenants
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>Iniciar sesión · BackupHub</PageTitle>

<h1 class="auth__title">Iniciar sesión</h1>
<p class="auth__subtitle">Administra y monitorea tus respaldos.</p>

@if (_error is not null)
{
    <div class="callout callout--danger animate-in" role="alert"><Icon Name="alert" Size="16" /> <span>@_error</span></div>
}

<EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login" class="auth__form">
    <DataAnnotationsValidator />
    <FormField Label="Correo" For="email">
        <InputText id="email" type="email" class="input" autocomplete="username" placeholder="tu@empresa.com" @bind-Value="Input.Email" />
        <ValidationMessage For="() => Input.Email" class="field__error" />
    </FormField>
    <FormField Label="Contraseña" For="password">
        <InputText id="password" type="password" class="input" autocomplete="current-password" @bind-Value="Input.Password" />
        <ValidationMessage For="() => Input.Password" class="field__error" />
    </FormField>
    <div class="auth__row">
        <label class="auth__remember">
            <InputCheckbox @bind-Value="Input.RememberMe" /> Mantener la sesión iniciada
        </label>
        <a class="auth__link" href="account/forgot-password">¿Olvidaste tu contraseña?</a>
    </div>
    <button type="submit" class="btn btn--primary btn--lg auth__submit">
        <span class="btn__label">Entrar</span> <Icon Name="arrow-right" Size="16" />
    </button>
</EditForm>

@code {
    private string? _error;

    [SupplyParameterFromForm] private LoginModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private async Task LoginAsync()
    {
        var user = await Users.FindByEmailAsync(Input.Email.Trim());
        if (user is not null && !await Users.IsInRoleAsync(user, AppRoles.SuperAdmin)
            && await Tenants.GetAsync(user.TenantId) is { Enabled: false })
        {
            _error = "Tu organización está deshabilitada. Contacta al administrador.";
            return;
        }

        var result = await SignIn.PasswordSignInAsync(Input.Email.Trim(), Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            user!.LastLoginAt = Time.GetUtcNow();
            await Users.UpdateAsync(user);
            Navigation.NavigateTo(SafeReturnUrl);
            return;
        }

        _error = result.IsLockedOut
            ? "La cuenta está bloqueada. Espera unos minutos o contacta al administrador."
            : "Correo o contraseña incorrectos.";
    }

    /// <summary>Solo rutas locales, para evitar redirecciones abiertas.</summary>
    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//", StringComparison.Ordinal) ? ReturnUrl : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Indica tu correo."), EmailAddress(ErrorMessage = "Correo no válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Indica tu contraseña.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; } = true;
    }
}
