@page "/account/reset-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Backup.Infrastructure.Identity
@inject PasswordRecovery Recovery

<PageTitle>@Title · BackupHub</PageTitle>

<h1 class="auth__title">@Title</h1>
<p class="auth__subtitle">@(IsInvitation ? "Bienvenido. Elige la contraseña con la que entrarás a BackupHub." : "Elige una contraseña nueva para tu cuenta.")</p>

@if (_done)
{
    <div class="callout callout--success animate-in" role="status"><Icon Name="check" Size="16" /> <span>Contraseña guardada. Ya puedes iniciar sesión.</span></div>
    <a class="btn btn--primary btn--lg auth__submit" href="account/login"><span class="btn__label">Iniciar sesión</span> <Icon Name="arrow-right" Size="16" /></a>
}
else if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code))
{
    <div class="callout callout--danger" role="alert"><Icon Name="alert" Size="16" /> <span>El enlace está incompleto. Ábrelo tal como llegó en el correo.</span></div>
    <p class="auth__footer"><a class="auth__link" href="account/forgot-password">Pedir un enlace nuevo</a></p>
}
else
{
    @if (_errors.Count > 0)
    {
        <div class="callout callout--danger animate-in" role="alert"><Icon Name="alert" Size="16" />
            <ul class="plain-list">@foreach (var error in _errors) { <li>@error</li> }</ul>
        </div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="SaveAsync" FormName="reset-password" class="auth__form">
        <DataAnnotationsValidator />
        <FormField Label="Nueva contraseña" For="password" Help="Mínimo 8 caracteres, con mayúscula, minúscula y número.">
            <InputText id="password" type="password" class="input" autocomplete="new-password" @bind-Value="Input!.Password" />
            <ValidationMessage For="() => Input.Password" class="field__error" />
        </FormField>
        <FormField Label="Confirmar contraseña" For="confirm">
            <InputText id="confirm" type="password" class="input" autocomplete="new-password" @bind-Value="Input.Confirm" />
            <ValidationMessage For="() => Input.Confirm" class="field__error" />
        </FormField>
        <button type="submit" class="btn btn--primary btn--lg auth__submit">
            <Icon Name="key" Size="16" /> <span class="btn__label">Guardar contraseña</span>
        </button>
    </EditForm>

    <p class="auth__footer"><a class="auth__link" href="account/forgot-password">Pedir un enlace nuevo</a></p>
}

@code {
    private bool _done;
    private IReadOnlyList<string> _errors = [];

    [SupplyParameterFromQuery(Name = "user")] private string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "invite")] private int? Invite { get; set; }
    [SupplyParameterFromForm] private ResetModel? Input { get; set; }

    private bool IsInvitation => Invite == 1;

    private string Title => IsInvitation ? "Define tu contraseña" : "Nueva contraseña";

    protected override void OnInitialized() => Input ??= new();

    private async Task SaveAsync()
    {
        var result = await Recovery.ResetAsync(UserId!, Code!, Input!.Password);
        _done = result.Success;
        _errors = result.Errors;
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Indica la contraseña.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "La confirmación no coincide.")]
        public string Confirm { get; set; } = string.Empty;
    }
}
