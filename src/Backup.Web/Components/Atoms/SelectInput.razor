<div class="select-wrap">
    <select id="@Id" class="input input--select @(Invalid ? "is-invalid" : null)" disabled="@Disabled" @onchange="HandleChange">
        @if (Placeholder is not null)
        {
            <option value="" selected="@(string.IsNullOrEmpty(Value))">@Placeholder</option>
        }
        @foreach (var option in Options)
        {
            <option value="@option.Value" selected="@(option.Value == Value)">@option.Label</option>
        }
    </select>
    <Icon Name="chevron-right" Size="14" Class="select-wrap__chevron" />
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<SelectOption> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task HandleChange(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        return ValueChanged.InvokeAsync(Value);
    }
}
