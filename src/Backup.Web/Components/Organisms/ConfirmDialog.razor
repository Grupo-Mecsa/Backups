@if (Visible)
{
    <div class="dialog-backdrop" @onclick="Cancel">
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dialog-title" @onclick:stopPropagation>
            <div class="dialog__icon dialog__icon--@(Danger ? "danger" : "accent")">
                <Icon Name="@(Danger ? "alert" : "info")" Size="22" />
            </div>
            <h2 id="dialog-title" class="dialog__title">@Title</h2>
            <p class="dialog__message">@Message</p>
            <div class="dialog__actions">
                <Button Variant="ButtonVariant.Secondary" OnClick="Cancel">Cancelar</Button>
                <Button Variant="@(Danger ? ButtonVariant.Danger : ButtonVariant.Primary)" Busy="_busy" OnClick="Confirm">@ConfirmText</Button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "¿Confirmar?";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool _busy;

    private async Task Confirm()
    {
        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }

        await VisibleChanged.InvokeAsync(false);
    }

    private Task Cancel() => _busy ? Task.CompletedTask : VisibleChanged.InvokeAsync(false);
}
