# Copia este archivo como .env junto a docker-compose.yml y completa los valores.
# .env está en .gitignore: nunca lo subas al repositorio.

BACKUP_PORT=8090
BACKUP_PUBLIC_URL=https://respaldos.example.com
TZ=America/Costa_Rica

# Primer administrador. Si dejas la contraseña vacía, se genera una y se muestra una sola vez en los logs.
BACKUP_ADMIN_EMAIL=admin@example.com
BACKUP_ADMIN_PASSWORD=
BACKUP_TENANT_NAME=Principal
# Enabled | Disabled (usa Disabled si el servidor es accesible desde redes que no controlas)
BACKUP_REGISTRATION=Disabled

# SMTP de la plataforma (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=Auto
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=BackupHub

# Bot de Telegram para alertas (opcional, token de @BotFather)
TELEGRAM_BOT_TOKEN=

# Cuentas en la nube: cliente OAuth para el botón «Conectar con …» (opcional; ver docs/nube.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# WhatsApp para alertas vía WAHA (opcional, https://waha.devlike.pro)
WHATSAPP_BASE_URL=http://waha:3000
WHATSAPP_API_KEY=
WHATSAPP_SESSION=default
